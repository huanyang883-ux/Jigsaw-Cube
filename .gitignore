*.jks

# Source artwork stays local; ship optimized public/assets/ files instead.
art-source/**/*.[pP][nN][gG]
art-source/**/*.[jJ][pP][gG]
art-source/**/*.[jJ][pP][eE][gG]
art-source/**/*.[wW][eE][bB][pP]
art-source/**/*.[aA][vV][iI][fF]
art-source/**/*.[gG][iI][fF]
art-source/**/*.[pP][sS][dD]

# Experiments, backups and generated reports are local working files.
# Keep only the regression baselines read by scripts/ so a fresh clone works.
art-source/experiments/**
!art-source/experiments/**/
